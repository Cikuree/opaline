#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf


# packwiz hashes the exact bytes
packs/** -text
packs/**/*.toml text eol=lf
packs/**/*.txt text eol=lf
packs/**/*.json text eol=lf
packs/**/*.cfg text eol=lf
packs/**/*.properties text eol=lf
